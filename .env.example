APP_NAME=JayVisionX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jayvisionx_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@jayvisionx.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ADMIN_EMAIL=admin@jayvisionx.com
# Bcrypt hash of the admin password (NOT the plaintext password). Generate with:
#   php -r "echo password_hash('your-password', PASSWORD_BCRYPT);"
ADMIN_PASSWORD_HASH=

WHATSAPP_NUMBER=919999999999
COMPANY_PHONE=+91-9999999999
COMPANY_EMAIL=info@jayvisionx.com
COMPANY_ADDRESS="Delhi NCR, India"

# ---- Lead notifications ----
# Email address that receives new-enquiry emails (defaults to the site email setting).
LEAD_NOTIFY_EMAIL=
# Google Apps Script web-app URL that appends leads to a Google Sheet (see docs/INTEGRATIONS.md).
GOOGLE_SHEETS_WEBHOOK_URL=

# ---- Support chatbot (AI) ----
# Anthropic Claude API key. Leave empty to run the chatbot in free DB/FAQ fallback mode.
ANTHROPIC_API_KEY=
# Model for the chatbot. claude-haiku-5-5 is fast & cheap (good for support);
# use claude-sonnet-5-5 or claude-opus-5-5 for smarter replies.
ANTHROPIC_MODEL=claude-haiku-5-5

# Chatbot AI providers — optional .env fallbacks. You can also enter a key per
# provider in Admin > AI Configuration (stored encrypted in the DB), then pick
# the active provider there. Supported: Claude, Gemini, OpenAI, DeepSeek, Grok, Mistral.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROK_API_KEY=
GROK_MODEL=grok-2-latest
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ---- Google Business Profile (reviews + Google Posts) ----
# OAuth client from Google Cloud Console. Requires an approved Business Profile
# API access request tied to your verified location. Leave empty to keep the
# integration in Admin > Integrations showing "not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES="https://www.googleapis.com/auth/business.manage"
# Shared key for the Google Ads lead-form webhook (Leads tagged "Google").
GOOGLE_LEAD_WEBHOOK_KEY=

# ---- Meta (Facebook + Instagram) ----
# Meta developer app. Requires Business Verification + App Review for the
# publishing & leads_retrieval permissions, and an IG Business account linked
# to the FB Page.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_SCOPES="pages_manage_posts,pages_read_engagement,pages_show_list,leads_retrieval,instagram_basic,instagram_content_publish"
# Meta Lead Ads webhook verify token + a Page token with leads_retrieval
# (Leads tagged "Meta").
META_LEAD_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
